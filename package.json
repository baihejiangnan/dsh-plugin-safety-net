{
  "name": "dsh-plugin-safety-net",
  "version": "0.1.2",
  "description": "Unified DSH plugin safety net with guarded installs, Web plugin management, and deep health checks.",
  "license": "MIT",
  "type": "module",
  "files": [
    "cordis.patch.yml",
    "lib",
    "README.md",
    "LICENSE",
    "pnpm-workspace.yaml",
    "bundled"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baihejiangnan/dsh-plugin-safety-net.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "dsh-plugin-guard": "file:bundled/dsh-plugin-guard",
    "dsh-plugin-healthcheck": "file:bundled/dsh-plugin-healthcheck",
    "dsh-web-plugin-manager": "file:bundled/dsh-web-plugin-manager"
  },
  "bundledDependencies": [
    "dsh-plugin-guard",
    "dsh-plugin-healthcheck",
    "dsh-web-plugin-manager"
  ],
  "engines": {
    "node": ">=18"
  }
}
